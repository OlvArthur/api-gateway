// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output = "./client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MECHANIC
  ADMIN
}

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  password  String
  name      String
  role      Role    @default(MECHANIC)
}
